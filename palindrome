#include <stdio.h> 
int main() {
char size = 6; 
char word[size]; // Input 5 numbers
  for(char i = 0; i < size; i++) {
                                    printf("\nEnter a word %d/%d: ", i + 1,size);
scanf(" %c", &word[i]); 
  }                            printf("\nOriginal => "); 
for(char i = 0; i < size; i++) { 
printf(" %c", word[i]); 
} 
printf("\nReverse => "); 
for(char i = size - 1; i >= 0; i--) {
printf(" %c", word[i]);
} 
char tail = size - 1;
char isPalindrome = 1;
for(char head = 0; head < size / 2; head++) { 
if(word[head] != word[tail]) { isPalindrome = 0;
break; }
tail--;
} if(isPalindrome) { 
printf("\nPalindrome: Yes"); 
} else {
printf("\nPalindrome: No");
}
return 0;
}
